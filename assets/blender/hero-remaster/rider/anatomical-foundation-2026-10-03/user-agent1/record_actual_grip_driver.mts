import {preview} from 'vite';
import {webkit} from 'playwright';
import {decodeJSON,expandFrames} from '../../../../../../src/core/replay';
const root=process.cwd(),out=path.join(root,'docs/evidence/hero-remaster/anatomical-foundation-2026-10-03/user-agent1/hand-grip105');
fs.mkdirSync(out,{recursive:true});assert(!fs.existsSync(path.join(out,'actual-driver.json')));
