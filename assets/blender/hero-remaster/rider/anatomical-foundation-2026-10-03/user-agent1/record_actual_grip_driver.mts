  for(const old of fixture.matchedSamples){const row=trace.find(r=>r.inputTick===old.inputTick);assert.equal(row.hash,old.stateHash,`${id} tick${old.inputTick}`);assert.equal(row.phase,old.phase);}
  const file=path.join(out,id+'.json');fs.writeFileSync(file,JSON.stringify({id,source37SHA256:model.sha256,recordingSHA256:sha(rb),window:fixture.window,samples})+'\n');report.cases.push({id,inputTicks:inputs.length,observedSamples:samples.length,recordingSHA256:sha(rb),file:path.relative(root,file),sha256:sha(fs.readFileSync(file)),fixtureMatchedHashes:true,phaseCounts:Object.fromEntries(['riding','crashed','finished'].map(p=>[p,samples.filter(r=>r.phase===p).length]))});console.log(JSON.stringify(report.cases.at(-1)));
 }
 await Promise.all(responses);assert.deepEqual(report.errors,[]);assert(report.loaded.some((r:any)=>r.sha256===model.sha256&&r.status===200));assert(report.loaded.some((r:any)=>r.sha256==='e55919d60267849358ef5e97f4731f42fac6eb2835b9998e1d146d056c0f10f7'&&r.status===200));report.status='INDEPENDENT_ACTUAL_BIKE_AND_51_BONE_CONTROL_STREAM_RECORDED';
}catch(e){report.failure=String(e);process.exitCode=1;}finally{fs.writeFileSync(path.join(out,'actual-driver.json'),JSON.stringify(report,null,2)+'\n');await context.close();await browser.close();await new Promise<void>(resolve=>server.httpServer!.close(()=>resolve()));console.log(JSON.stringify({status:report.status,failure:report.failure,cases:report.cases.length}));}
