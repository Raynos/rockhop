const manifestBytes=fs.readFileSync(path.join(build,'hero-review.json')),manifest=JSON.parse(manifestBytes.toString());
const model=manifest.models.find((m:any)=>m.logical==='models/rider-street-mustard.glb');assert.equal(model.sha256,'3ffd591d6872513646cab2384f8fe6b21f828ab57bdb5842cc1659fcd32face2');assert.equal(sha(fs.readFileSync(path.join(build,model.url))),model.sha256);
