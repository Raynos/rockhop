 await page.goto(server.resolvedUrls!.local[0]+'?harness=1&audio=0&sw=0&outfit=street-mustard&physics=v2&hz=120');await page.waitForFunction(()=>(window as any).__rockhop?.ready,null,{timeout:120000});
