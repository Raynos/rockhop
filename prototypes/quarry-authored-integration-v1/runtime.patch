+          ...QUARRY_STANDARD_REPLACE.authoredBatches,
+        ]);
+        const retiredBatches = zk.batches.filter(batch => retiredNames.has(batch.name));
+        const keepMeshes = zk.meshes.filter(mesh => !retiredMeshes.includes(mesh));
+        const keepBatches = zk.batches.filter(batch => !retiredBatches.includes(batch));
+        zk.meshes.splice(0, zk.meshes.length, ...keepMeshes);
+        zk.batches.splice(0, zk.batches.length, ...keepBatches);
+
+        const fallback = new THREE.Group(); fallback.name = 'd1-original-quarry-fallback';
+        fallback.add(...retiredMeshes, ...buildBatches(retiredBatches).objects);
