diff --git a/src/render/world/zones/coastHarbor.ts b/src/render/world/zones/coastHarbor.ts
--- a/src/render/world/zones/coastHarbor.ts
+++ b/src/render/world/zones/coastHarbor.ts
@@ -72,0 +73,14 @@
+}
+
+/** Sparse far-water bank for C2/C3. Keep the ridden pier/crane and breach art. */
+export function planFarCoastHarbor(courseId: string, seaY: number): CoastHarborPlacement[] {
+  const anchors: readonly (readonly [CoastHarborVariant, number, number, number])[] = courseId === 'c2-crane-hop'
+    ? [['cargo-freighter', 47, -85, .82], ['cargo-freighter', 186, -104, .90],
+      ['cargo-barge', 248, -67, .68], ['cargo-freighter', 389, -91, .82]]
+    : [['cargo-freighter', 44, -86, .82], ['loading-pier', 133, -57, .72],
+      ['harbor-crane', 129, -56, .68], ['cargo-freighter', 187, -111, .78],
+      ['cargo-freighter', 371, -91, .82]];
+  return anchors.map(([variant, x, z, scale]) => ({
+    variant, x, y: variant === 'loading-pier' || variant === 'harbor-crane' ? seaY + 2.6 : seaY,
+    z, scale,
+  }));
