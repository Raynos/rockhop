# Vercel builds every file under api/ into a function; the vitest beside the handler is not one.
api/*.test.ts

# Omit local build output and non-shipping assets from Vercel input. CI creates its
# production artifact with `vercel build` and uploads that output with `--prebuilt`.
dist/
harness/out/
assets/blender/
assets/design/
docs/evidence/
project/releases/

# Store release P0.2: source maps never deploy (vite.config.ts moves them to dist-maps/; belt and braces here).
*.map
dist-maps/
